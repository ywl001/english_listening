/* 内联模式容器：嵌入页面列表区 */
.inline-wrap {
  padding: 0;
}

/* 遮罩：淡入淡出 */
.search-mask {
  position: fixed;
  inset: 0;
  z-index: 400;
  background-color: rgba(0, 0, 0, .4);
  opacity: 0;
  transition: opacity .3s ease;
}

.search-mask.show {
  opacity: 1;
}

/* 面板：从顶部滑入 */
.search-panel {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  max-height: 75vh;
  display: flex;
  flex-direction: column;
  background-color: #F7FAFC;
  border-radius: 0 0 32rpx 32rpx;
  transform: translateY(-100%);
  transition: transform .3s ease;
  overflow: hidden;
}

.search-panel.show {
  transform: translateY(0);
}

/* 顶部搜索栏 */
.search-header {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background-color: #FFFFFF;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background-color: #F1F5F9;
  border-radius: 36rpx;
  padding: 0 24rpx;
  height: 72rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #2D3748;
  height: 72rpx;
}

.input-placeholder {
  color: #A0AEC0;
  font-size: 28rpx;
}

.clear-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 8rpx;
}

.close-btn {
  flex-shrink: 0;
  padding: 0 12rpx 0 24rpx;
  font-size: 28rpx;
  color: #718096;
}

.close-btn:active {
  color: #2B6CB0;
}

/* 结果滚动区 */
.search-body {
  flex: 1;
  min-height: 300rpx;
  padding: 24rpx 30rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.tip {
  text-align: center;
  color: #A0AEC0;
  font-size: 26rpx;
  padding: 80rpx 0;
}

/* 结果卡片（与 sentence-list 同款风格） */
.result-card {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(160, 174, 192, .12);
}

.card-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.en {
  font-size: 28rpx;
  font-weight: bold;
  color: #2D3748;
  line-height: 1.4;
}

.zh {
  font-size: 24rpx;
  color: #718096;
  line-height: 1.5;
  margin-top: 8rpx;
}

.book {
  font-size: 20rpx;
  color: #A0AEC0;
  margin-top: 10rpx;
}

/* 右侧收藏按钮 */
.add-btn {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  width: 100rpx;
  margin-left: 16rpx;
}

.add-btn:active {
  transform: scale(.92);
}

.add-label {
  font-size: 20rpx;
  color: #A0AEC0;
}

.add-btn.added .add-label {
  color: #F6AD55;
}
