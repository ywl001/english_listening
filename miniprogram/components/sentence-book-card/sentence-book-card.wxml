<van-swipe-cell id="swipeCell" right-width="{{140}}" disabled="{{!book.isCustom}}">
  <view class="book-card" bindtap="onTap">
    <view class="cover {{coverTheme}}">
      <text class="cover-title">{{book.alias || book.name}}</text>
    </view>

    <view class="info">
      <view class="title-row">
        <text class="title">{{book.name}}</text>
        <view class="action-icons" wx:if="{{isUserBook}}">
        </view>
      </view>

      <view class="meta">
        <text wx:if="{{book.content === 'article'}}">{{book.count || 0}} 篇文章</text>
        <text wx:else>{{book.learnedCount || 0}} / {{book.count || 0}} sentences</text>
        <text class="tag" wx:if="{{!isUserBook}}">官方</text>
      </view>

      <view class="progress-bar-bg">
        <view class="progress-bar-fill" style="width: {{progressPercent}}"></view>
      </view>
    </view>

    <text class="arrow">›</text>
  </view>

  <view wx:if="{{isUserBook}}" slot="right" class="swipe-actions">
    <view class="edit-btn" catchtap="onEdit">编辑</view>
    <view class="delete-btn" catchtap="onDelete">删除</view>
  </view>
</van-swipe-cell>