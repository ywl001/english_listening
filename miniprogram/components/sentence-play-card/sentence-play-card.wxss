/* 1. 关键：微信小程序自定义组件根节点撑满父容器 */
:host {
  width: 100%;
  height: 100%;
  display: block;
}

.sentence-card {
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  background-color: #ffffff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.04);

  /* Flex 上下布局，撑满高度 */
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

/* 2. 英文/中文展示区域：自动分配剩余空间，居中显示 */
.text-section {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  width: 100%;
  padding: 20rpx 0;
  background-color: #f8f9f4;
  border-radius: 50rpx;
}

.english-text {
  font-size: 40rpx;
  font-weight: 600;
  color: #2c3e50;
  line-height: 1.4;
}

.chinese-text {
  font-size: 32rpx;
  color: #7f8c8d;
  line-height: 1.5;
}

.placeholder-text {
  font-size: 28rpx;
  color: #bdc3c7;
}

/* 3. 中间分割线与提示 */
.divider-container {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 20rpx 0;
  width: 100%;
}

.divider-container .line {
  flex: 1;
  height: 1rpx;
  background-color: #dadada;
}

.hint-text {
  font-size: 22rpx;
  color: #cccccc;
  padding: 0 24rpx;
}

/* 4. 底部状态操作栏 (收藏/已会/忘记/熟悉) */
.action-bar {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding-top: 32rpx;
  border-top: 1rpx solid #f8f9fa;
  width: 100%;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  color: #8c8c8c;
  font-size: 24rpx;
}

.action-label {
  font-size: 24rpx;
}

/* 选中高亮颜色 */
.active-favorite {
  color: #ff4d4f;
}

.active-mastered {
  color: #52c41a;
}

.active-forgot {
  color: #fa8c16;
}

.active-familiar {
  color: #1890ff;
}