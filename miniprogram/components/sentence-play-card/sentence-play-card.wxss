/* 修改宿主节点的默认行为 */
:host {
  width: 100%;
  height: 100%;
  flex: 1;
  display: flex;
  flex-direction: column;
}
.main-card {
  width: 100%;
  height: 100%;
  border-radius: 36rpx;
  padding: 40rpx 40rpx 30rpx 40rpx;
  box-sizing: border-box;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

/* 内容主体撑开顶部空间 */
.card-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-around;
}

.card-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  flex: 1;
  justify-content: center;
}

.lang-tag {
  font-size: 24rpx;
  color: #A0AEC0;
  font-weight: 700;
  margin-bottom: 24rpx;
  letter-spacing: 3rpx;
}

.sentence-en {
  font-size: 48rpx;
  font-weight: 400;
  color: #1A202C;
  text-align: center;
  line-height: 1.4;
  word-break: break-word;
  opacity: 0.01;
}

.sentence-en.show{
  opacity:1
}

.sentence-zh {
  font-size: 48rpx;
  font-weight: 600;
  color: #2D3748;
  text-align: center;
  line-height: 1.5;
  transition: opacity 0.2s ease;
  opacity: 0.1;
}

.sentence-zh.show{
  opacity: 1;
}

.sentence-zh.hidden {
  opacity: 0;
}

.divider {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70%;
  margin: 20rpx 0;
  flex-shrink: 0;
}

.divider .line {
  flex: 1;
  height: 2rpx;
  background-color: #EDF2F7;
}

.divider-icon {
  font-size: 26rpx;
  color: #CBD5E0;
  margin: 0 24rpx;
  font-style: italic;
  font-weight: 600;
}

/* 新增底部按钮组区域 */
.card-actions {
  display: flex;
  justify-content: space-around;


  width: 100%;
  padding-top: 100rpx;
  border-top: 1rpx solid #F7FAFC;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.action-text {
  font-size: 24rpx;
  line-height: 32rpx;
}

.action-btn.active {
  background-color: #EBF8FF;
  border-color: #3182CE;
}

.action-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #4A5568;
}

.action-btn.active .action-text {
  color: #2B6CB0;
}