/* 组件私有样式，绝对隔离 */
.modal-wrapper {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  visibility: hidden;
  opacity: 0;
  transition: all 0.3s ease;
}

.modal-wrapper.show {
  visibility: visible;
  opacity: 1;
}

.mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
}

.drawer {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #FFFFFF;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  padding: 32rpx 32rpx env(safe-area-inset-bottom);
}

.modal-wrapper.show .drawer {
  transform: translateY(0);
}

.drawer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.drawer-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1A202C;
}

.close-btn {
  font-size: 36rpx;
  color: #A0AEC0;
  padding: 10rpx;
}

.drawer-content {
  max-height: 55vh;
  padding: 24rpx 0;
}

.setting-group {
  margin-bottom: 32rpx;
}

.group-title {
  font-size: 26rpx;
  color: #718096;
  margin-bottom: 16rpx;
  display: block;
}

/* 分段按钮 */
.segment {
  display: flex;
  background-color: #EDF2F7;
  border-radius: 16rpx;
  padding: 6rpx;
}

.segment-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #4A5568;
  border-radius: 12rpx;
  transition: all 0.2s;
}

.segment-item.active {
  background-color: #FFFFFF;
  color: #2B6CB0;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

/* 网格选项框 */
.options-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.option-card {
  text-align: center;
  padding: 18rpx 0;
  background-color: #F7FAFC;
  border: 2rpx solid #E2E8F0;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #4A5568;
}

.option-card.active {
  background-color: #EBF8FF;
  border-color: #3182CE;
  color: #3182CE;
  font-weight: bold;
}

.drawer-footer {
  padding-top: 16rpx;
}

.save-btn {
  background-color: #2B6CB0;
  color: #FFFFFF;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: bold;
  height: 88rpx;
  line-height: 88rpx;
}