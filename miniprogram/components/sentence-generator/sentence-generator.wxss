.page {
  min-height: 100vh;
  padding: 24rpx 0;
  box-sizing: border-box;
  background: #f5f6fa;
}
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 24rpx rgba(31, 34, 51, 0.04);
}

.label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #1F2233;
  margin-bottom: 16rpx;
}

.textarea {
  width: 100%;
  height: 140rpx;
  background: #F7F8FC;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 30rpx;
  color: #1F2233;
  line-height: 1.6;
  box-sizing: border-box;
}

.lang-hint {
  display: block;
  font-size: 22rpx;
  color: #6C5CE7;
  margin-top: 12rpx;
}

.bottom-placeholder {
  height: 140rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 99;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 24rpx rgba(31, 34, 51, .06);
  box-sizing: border-box;
}

.bottom-bar van-button {
  flex: 1;
}

