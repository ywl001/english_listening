<view class="page">

  <view class="card">
    <text class="label">输入句子（中文或英文）</text>
    <textarea class="textarea" placeholder="例如：今天天气真不错 或 The weather is nice today" bindinput="onInput" value="{{inputText}}" maxlength="500" />
    <text class="lang-hint">{{detectedLang === 'zh' ? '检测到：中文 → 将翻译为英文' : '检测到：英文 → 将翻译为中文'}}</text>
  </view>

  <van-cell-group inset wx:if="{{genError}}">
    <van-cell title="生成失败" label="{{genError}}" />
  </van-cell-group>

  <van-cell-group  wx:if="{{zh || en}}">

    <van-cell wx:if="{{zh}}" title="中文" label="{{zh}}"  bind:click="playZh" size="large">
      <van-icon slot="right-icon" name="volume-o" size="20" />
    </van-cell>

    <van-cell wx:if="{{en}}" title="英文" label="{{en}}"  bind:click="playEn" size = 'large'>
      <van-icon slot="right-icon" name="volume-o" size="20" />
    </van-cell>

  </van-cell-group>

  <view class="bottom-placeholder"></view>

  <view class="bottom-bar">
    <block wx:if="{{tempAudioUrl && tempAudioZhUrl}}">
      <van-button block type="primary" loading="{{saving}}" disabled="{{saving || !selectedBookId}}" bind:click="onSave">
        保存到句子库
      </van-button>
    </block>

    <van-button wx:else block type="info" loading="{{generating}}" disabled="{{generating || !inputText}}" bind:click="onTranslateAndGenerate">
      翻译并生成发音
    </van-button>
  </view>

</view>