/* 1. 页面基础全局重置 */
page {
  background-color: #F7FAFC;
  min-height: 100vh;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* 底部悬浮内容切换：两个独立圆形按钮（无背景，与页面风格一致） */
.fab-btn {
  position: fixed;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  left: 40rpx;
  right: auto;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background-color: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #A0AEC0;
  box-shadow: 0 4rpx 16rpx rgba(160, 174, 192, .35);
  z-index: 1;
  transition: all .2s;
}

.fab-btn:active {
  transform: scale(.94);
}

.fab-btn.active {
  color: #2B6CB0;
  box-shadow: 0 4rpx 20rpx rgba(43, 108, 176, .35);
}

.fab-btn.active .fab-label {
  font-weight: bold;
}

.fab-label {
  font-size: 20rpx;
  line-height: 1.2;
  margin-top: 2rpx;
}

/* 文章按钮放右下角，句子按钮放左下角 */
.fab-article {
  left: auto;
  right: 40rpx;
}

/* 空态提示 */
.empty-tip {
  text-align: center;
  color: #A0AEC0;
  font-size: 28rpx;
  padding: 120rpx 0;
}

/* 2. 顶部 Tab 栏布局 (包含 Tab 组和右侧齿轮) */
.tab-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #E2E8F0;
  padding: 0 20rpx 0 0;
  box-sizing: border-box;
}

/* 左侧 Tab 组：撑满左侧大比例区域 */
.tab-group {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

/* 右侧全局搜索入口 */
.search-btn {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-btn:active {
  opacity: .6;
}

/* 两个 Tab 选项卡：平分左侧空间 */
.tab-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 30rpx;
  color: #718096;
  position: relative;
  font-weight: 500;
}

/* Tab 间的竖线分界 */
.tab-item:first-child {
  border-right: 2rpx solid #E2E8F0;
}

.tab-item.active {
  color: #2B6CB0;
  font-weight: bold;
}

/* Tab 选中时的底部蓝条指示器 */
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 80rpx;
  height: 6rpx;
  background-color: #2B6CB0;
  border-radius: 4rpx;
}

/* 3. 滚动容器（底部留出悬浮胶囊的避让空间） */
.book-list {
  flex: 1;
  padding: 24rpx 30rpx 200rpx 30rpx;
  box-sizing: border-box;
}

/* 4. 新建句子书卡片（仅留在父页面） */
.create-card {
  border: 2rpx dashed #3182CE;
  background: #FFFFFF;
  border-radius: 20rpx;
  height: 120rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  color: #3182CE;
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.create-card .plus {
  font-size: 40rpx;
  margin-right: 12rpx;
  line-height: 1;
}