<view class="container">
  <!-- 顶部 Tab 栏（仅句子模式；文章暂只有系统书） -->
  <view class="tab-header" wx:if="{{activeContent === 'sentence'}}">
    <view class="tab-group">
      <view class="tab-item {{activeTab === 'system' ? 'active' : ''}}" bindtap="switchTab" data-tab="system">系统推荐</view>
      <view class="tab-item {{activeTab === 'user' ? 'active' : ''}}" bindtap="switchTab" data-tab="user">用户自定义</view>
    </view>
  </view>

  <!-- 句子书列表滚动区 -->
  <scroll-view scroll-y class="book-list" wx:if="{{activeContent === 'sentence'}}">
    <!-- 首次加载中 -->
    <view wx:if="{{loading}}" class="loading-tip">
      <van-loading size="40rpx" color="#3182CE" text-color="#718096">加载中...</van-loading>
    </view>

    <block wx:else>
      <!-- 新建按钮 -->
      <view wx:if="{{activeTab === 'user'}}" class="create-card" bindtap="openCreateBook">
        <text class="plus">+</text>
        <text>新建句子书</text>
      </view>

      <!-- 句子书卡片组件 -->
      <block wx:for="{{activeTab === 'system' ? systemBooks : userBooks}}" wx:key="_id">
        <sentence-book-card book="{{item}}" index="{{index}}" isUserBook="{{activeTab === 'user'}}" bind:tapcard="onTapBook" bind:edit="onEditBook" bind:delete="onDeleteBook" />
      </block>
    </block>
  </scroll-view>

  <!-- 文章书列表 -->
  <scroll-view scroll-y class="book-list" wx:if="{{activeContent === 'article'}}">
    <view wx:if="{{loading}}" class="loading-tip">
      <van-loading size="40rpx" color="#3182CE" text-color="#718096">加载中...</van-loading>
    </view>
    <block wx:else>
      <block wx:for="{{articleBooks}}" wx:key="_id">
        <sentence-book-card book="{{item}}" index="{{index}}" isUserBook="{{false}}" bind:tapcard="onTapBook" />
      </block>
      <view wx:if="{{!articleBooks.length}}" class="empty-tip">暂无文章书</view>
    </block>
  </scroll-view>

  <!-- 新建 / 重命名句子书弹窗（复用同一组件，编辑模式预填旧名） -->
  <book-create
    visible="{{showBookCreate}}"
    title="{{editingBook ? '重命名句子书' : '新建句子书'}}"
    initial-name="{{editingBook ? editingBook.name : ''}}"
    bind:confirm="onCreateBook"
    bind:close="closeBookCreate"
  />

  <!-- 底部悬浮内容切换：两个独立按钮 -->
  <view class="fab-btn {{activeContent === 'sentence' ? 'active' : ''}}" bindtap="switchContent" data-content="sentence">
    <van-icon name="chat-o" size="22px" />
    <text class="fab-label">句子</text>
  </view>

  <view class="fab-btn fab-article {{activeContent === 'article' ? 'active' : ''}}" bindtap="switchContent" data-content="article">
    <van-icon name="notes-o" size="22px" />
    <text class="fab-label">文章</text>
  </view>

</view>