/* 1. 页面基础全局重置 */
page {
  background-color: #F7FAFC;
  min-height: 100vh;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* 2. 顶部 Tab 栏布局 (包含 Tab 组和右侧齿轮) */
.tab-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #E2E8F0;
  padding: 0 20rpx 0 0;
  box-sizing: border-box;
}

/* 左侧 Tab 组：撑满左侧大比例区域 */
.tab-group {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

/* 两个 Tab 选项卡：平分左侧空间 */
.tab-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 30rpx;
  color: #718096;
  position: relative;
  font-weight: 500;
}

/* Tab 间的竖线分界 */
.tab-item:first-child {
  border-right: 2rpx solid #E2E8F0;
}

.tab-item.active {
  color: #2B6CB0;
  font-weight: bold;
}

/* Tab 选中时的底部蓝条指示器 */
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 80rpx;
  height: 6rpx;
  background-color: #2B6CB0;
  border-radius: 4rpx;
}

/* 右侧小齿轮设置按钮 */
.settings-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: #F7FAFC;
  margin-right: 20rpx;
}

.settings-btn:active {
  background-color: #EDF2F7;
}

.gear-icon {
  font-size: 30rpx;
  color: #4A5568;
}

/* 3. 滚动容器 */
.book-list {
  flex: 1;
  padding: 24rpx 30rpx 30rpx 30rpx;
  box-sizing: border-box;
}

/* 4. 新建句子书卡片（仅留在父页面） */
.create-card {
  border: 2rpx dashed #3182CE;
  background: #FFFFFF;
  border-radius: 20rpx;
  height: 120rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  color: #3182CE;
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.create-card .plus {
  font-size: 40rpx;
  margin-right: 12rpx;
  line-height: 1;
}