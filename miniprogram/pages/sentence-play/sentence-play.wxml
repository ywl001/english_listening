<view class="container">
  <!-- 1. 顶部 Header 与进度条 -->
  <view class="header-section">
    <view class="header">
      <view class="header-center">
        <text class="header-title">Playback Player</text>
        <text class="book-subtitle">{{bookTitle || 'Sentence Play'}} | {{currentIndex + 1}}/{{totalCount}}</text>
      </view>
      <view class="header-placeholder"></view>
    </view>

    <view class="progress-bar-bg">
      <view class="progress-bar-fill" style="width: {{ totalCount ? (((currentIndex + 1) / totalCount) * 100) + '%' : '0%' }};"></view>
    </view>
  </view>

  <!-- 2. 中央卡片滑动区域 -->
  <view class="card-wrapper">
    <!-- current 改为绑定 swiperCurrent，不要绑定在 Swiper 节点上截断点击事件 -->
    <swiper 
      class="card-swiper" 
      current="{{swiperCurrent}}" 
      duration="300" 
      circular="{{ true }}" 
      bindchange="onSwiperChange"
    >
      <block wx:for="{{displayList}}" wx:key="index">
        <swiper-item class="swiper-item-inner">
          <!-- 点击空白区域：播放/暂停（文字区域在卡片内 catchtap，不冒泡） -->
          <view class="card-tap-area" bindtap="onTogglePlay">
          <sentence-play-card
            wx:if="{{item}}"
            sentence="{{item}}" 
            favoriteBookName = "{{favoriteBookName}}"
            book-names="{{bookNames}}"
            show-english="{{ showEnglish }}"
            show-chinese="{{ showChinese }}"
            data-data="{{item}}" 
            bind:toggleFavorite="onToggleFavorite"
            bind:setStage="onSetStage"
            bind:longtapFavorite="onLongTapFavorite"
            bind:toggleEnglish="onToggleEnglish"
            bind:toggleChinese="onToggleChinese"
          />
          </view>
        </swiper-item>
      </block>
    </swiper>
  </view>

  <!-- 3. 底部控制组件 -->
  <view class="player-bar-wrapper">
    <play-bar
      is-playing="{{ isPlaying }}"
      initial-order="{{ playOrder }}"
      initial-repeat="{{ repeatCount }}"
      initial-limit="{{ limitCount }}"
      bind:togglePlay="onTogglePlay"
      bind:orderChange="onOrderChange"
      bind:repeatChange="onRepeatChange"
      bind:limitChange="onLimitChange"
      bind:prev="onPrevSentence"
      bind:next="onNextSentence"
    />
  </view>

  <book-select-sheet 
    show="{{ showBookSelectSheet }}" 
    book-list="{{ myBooks }}" 
    auto-save="{{ autoSavePreference }}" 
    bind:close="handleCloseModal" 
    bind:select="handleSelectBook" 
    bind:create="handleCreateBook" 
    bind:autoSaveChange="handleAutoSaveChange" 
  />
</view>