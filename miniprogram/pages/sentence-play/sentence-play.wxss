page {
  background-color: #F4F6F9;
  height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  overflow: hidden;
}

.container {
  display: flex;
  flex-direction: column;
  /* 覆盖 app.wxss 全局 .container 的 align-items: center，防止 flex 子元素水平收缩 */
  align-items: stretch;
  height: 100vh;
  padding: 0 32rpx 30rpx 32rpx; /* 适当调小底部 padding */
  box-sizing: border-box;
}

/* 1. Header 与进度条包装器 */
.header-section {
  flex-shrink: 0;
}

.header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 20rpx;
  padding-bottom: 16rpx;
  position: relative;
}

.header-center {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A202C;
}

.book-subtitle {
  font-size: 22rpx;
  color: #718096;
  margin-top: 4rpx;
}

.progress-bar-bg {
  width: 100%;
  height: 6rpx;
  background-color: #E2E8F0;
  border-radius: 3rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.progress-bar-fill {
  height: 100%;
  background-color: #2B6CB0;
  border-radius: 3rpx;
  transition: width 0.3s ease;
}

/* 2. 卡片区域：核心点 min-height: 0 避免被子元素无限撑大 */
.card-wrapper {
  flex: 1;
  min-height: 0; /* 关键：防止 flex 子项撑满导致底部被挤出 */
  max-height: 58vh; /* 卡片不占满剩余空间，给底部控制区留出呼吸感 */
  width: 100%;
  margin: 10rpx 0 20rpx 0;
}

.card-swiper {
  width: 100%;
  height: 100%;
}

.swiper-item-inner {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}

/* 点击空白区域触发播放/暂停的承载层（铺满卡片） */
.card-tap-area {
  width: 100%;
  height: 100%;
}

/* 3. 底部控制栏区域：固定不被挤压 */
.player-bar-wrapper {
  flex-shrink: 0;
  width: 100%;
}