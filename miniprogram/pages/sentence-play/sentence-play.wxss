page {
  background-color: #F4F6F9;
  height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 0 32rpx 40rpx 32rpx;
  box-sizing: border-box;
  justify-content: space-between;
}

/* Header 与进度条 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  padding-bottom: 16rpx;
}

.back-btn {
  font-size: 38rpx;
  color: #2D3748;
  padding: 10rpx 20rpx 10rpx 0;
}

.header-center {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A202C;
}

.book-subtitle {
  font-size: 22rpx;
  color: #718096;
  margin-top: 4rpx;
}

.header-placeholder {
  width: 40rpx;
}

.progress-bar-bg {
  width: 100%;
  height: 6rpx;
  background-color: #E2E8F0;
  border-radius: 3rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
}

.progress-bar-fill {
  height: 100%;
  background-color: #2B6CB0;
  border-radius: 3rpx;
  transition: width 0.3s ease;
}

/* 2. 卡片外部包装器 */
.card-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 30rpx 0;
  width: 100%;
}

/* 3. 胶囊按钮组 */
.capsule-bar {
  display: flex;
  justify-content: space-between;
  width: 100%;
  margin-bottom: 40rpx;
}

.capsule-btn {
  flex: 1;
  margin: 0 10rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.02);
  border: 2rpx solid transparent;
}

.capsule-btn.active {
  border-color: #3182CE;
  background-color: #EBF8FF;
}

.capsule-title {
  font-size: 22rpx;
  color: #2D3748;
  font-weight: 600;
}

.capsule-sub {
  font-size: 20rpx;
  color: #4A5568;
  margin-top: 4rpx;
}

/* 4. 底部控制盘 */
.control-panel {
  display: flex;
  align-items: center;
  justify-content: space-around;
  width: 100%;
  padding: 10rpx 0;
}

.ctrl-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.04);
}

.ctrl-btn.sm {
  width: 84rpx;
  height: 84rpx;
  color: #4A5568;
  font-size: 26rpx;
}

.ctrl-btn.main {
  width: 120rpx;
  height: 120rpx;
  background: #2B6CB0;
  color: #FFFFFF;
  font-size: 38rpx;
  box-shadow: 0 10rpx 24rpx rgba(43, 108, 176, 0.3);
}

.icon-text {
  font-size: 22rpx;
  font-weight: bold;
  color: #4A5568;
}