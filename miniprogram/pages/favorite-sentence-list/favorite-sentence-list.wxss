page {
  background-color: #f7f8fa;
  min-height: 100vh;
}

.container {
  padding: 0 24rpx 140rpx;
  box-sizing: border-box;
  width: 100%;
}

/* ========== 添加按钮行 ========== */
.add-bar {
  display: flex;
  justify-content: flex-end;   /* 按钮靠右 */
  align-items: center;
  padding: 12rpx 8rpx 8rpx;
  margin-bottom: 8rpx;
}

.add-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #2f80ed;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(47, 128, 237, 0.35);
}

.add-icon {
  color: #fff;
  font-size: 40rpx;
  font-weight: 400;
  line-height: 1;
  margin-top: -4rpx;
}

/* 搜索框保持原样即可 */
.search-bar {
  width: 100%;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

/* ========== 搜索框 ========== */
.search-bar {
  width: 100%;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.search-input {
  width: 100%;
  background: #ffffff;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  color: #333333;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
  box-sizing: border-box;
  text-align: center;
}

/* ========== 句子卡片 ========== */
.sentence-card {
  width: 100%;
  box-sizing: border-box;
  background: #ffffff;
  padding: 32rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.playing-card {
  background-color: #eef6ff;
  border-color: #2f80ed;
  box-shadow: 0 4rpx 16rpx rgba(47, 128, 237, 0.08);
}

.card-left {
  flex: 1;
  padding-right: 24rpx;
}

.en-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.index-num {
  color: #1a1a1a;
}

.zh-text {
  font-size: 26rpx;
  color: #666666;
}

/* ========== 收藏心形 ========== */
.favorite-btn {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background-color: #2686ec;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(47, 128, 237, 0.3);
}

.heart {
  width: 16rpx;
  height: 16rpx;
  background: #fff;
  position: relative;
  transform: rotate(-45deg);
}

.heart::before,
.heart::after {
  content: "";
  width: 16rpx;
  height: 16rpx;
  background: #fff;
  border-radius: 50%;
  position: absolute;
}

.heart::before {
  top: -8rpx;
  left: 0;
}

.heart::after {
  top: 0;
  left: 8rpx;
}

/* ========== 底部悬浮按钮 ========== */
.bottom-floating-bar {
  position: fixed;
  bottom: 40rpx;
  left: 24rpx;
  right: 24rpx;
  z-index: 100;
}

.play-all-btn {
  width: 100% !important;
  height: 96rpx;
  background: #ffde94;
  color: #5c3c00;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(255, 222, 148, 0.55);
  
  display: flex !important;
  flex-direction: row !important;
  align-items: center !important;
  justify-content: center !important;
  padding: 0 !important;
  margin: 0 !important;
  line-height: normal !important;
}

.play-all-btn::after {
  border: none;
}

.play-all-btn .icon {
  margin-right: 12rpx;
  font-size: 34rpx;
  display: flex;
  align-items: center;
}

/* ========== 空状态 & 骨架屏 ========== */
.empty-box {
  padding: 120rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.skeleton-list {
  width: 100%;
}

.skeleton-card {
  position: relative;
  height: 150rpx;
  margin-bottom: 24rpx;
  padding: 32rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #fff;
  overflow: hidden;
}

.skeleton-line {
  height: 28rpx;
  border-radius: 8rpx;
  background: #e8e8e8;
  margin-bottom: 28rpx;
  position: relative;
  overflow: hidden;
}

.skeleton-line::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent, #fff, transparent);
  animation: skeleton-loading 1.5s infinite;
}

.skeleton-en {
  width: 85%;
}

.skeleton-zh {
  width: 60%;
  margin-bottom: 0;
}

@keyframes skeleton-loading {
  from { transform: translateX(-100%); }
  to { transform: translateX(100%); }
}

/* 可拖动悬浮按钮 */
.fab-add {
  position: fixed;
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: #2f80ed;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(47, 128, 237, 0.4);
  z-index: 101;
  /* 去掉 transition，拖动时更跟手 */
}

.fab-icon {
  color: #fff;
  font-size: 56rpx;
  font-weight: 300;
  line-height: 1;
  margin-top: -6rpx;
  pointer-events: none; /* 防止文字干扰触摸 */
}