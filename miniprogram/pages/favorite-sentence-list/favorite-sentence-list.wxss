page {
  background-color: #f7f8fa;
  min-height: 100vh;
}

.container {
  padding: 24rpx;
  padding-bottom: 140rpx; /* 为底部悬浮栏预留空间 */
  box-sizing: border-box;
  width: 100%;
}

/* 顶部搜索框 */
.search-bar {
  width: 100%;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}
.search-input {
  width: 100%;
  background: #ffffff;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  color: #333333;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.02);
  box-sizing: border-box;
  text-align: center; /* 让占位文字居中，更贴合原图风格 */
}

.swipe-item, van-swipe-cell {
  width: 100% !important;
  display: block !important;
  margin-bottom: 24rpx;
}

.sentence-card {
  width: 100%;
  box-sizing: border-box;
  background: #ffffff;
  padding: 32rpx;
  border-radius: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

/* 高亮正在播放的卡片 */
.playing-card {
  border-color: #2f80ed;
  background-color: #f0f6ff;
}

.card-left {
  flex: 1;
  padding-right: 24rpx;
}

.en-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.index-num {
  color: #1a1a1a;
}

.zh-text {
  font-size: 26rpx;
  color: #666666;
}

.play-btn {
  width: 64rpx;
  height: 64rpx;
  background-color: #2f80ed;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(47, 128, 237, 0.3);
}

.play-triangle {
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 10rpx 0 10rpx 18rpx;
  border-color: transparent transparent transparent #ffffff;
  margin-left: 4rpx;
}

.delete-btn {
  background-color: #ee0a24;
  color: #ffffff;
  width: 160rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  border-top-right-radius: 20rpx;
  border-bottom-right-radius: 20rpx;
}

/* 2. 底部悬浮容器：调整宽度占满卡片两端 */
.bottom-floating-bar {
  position: fixed;
  bottom: 40rpx;
  left: 24rpx;
  right: 24rpx; /* 取代 left: 50% + width: 90%，精准对齐两侧卡片边缘 */
  z-index: 100;
}

/* 3. 底部按钮：清除小程序 button 默认样式，重置 Flex 布局 */
.play-all-btn {
  width: 100% !important;
  height: 96rpx;
  background: #ffde94;
  color: #5c3c00;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(255, 222, 148, 0.5);
  
  /* 解决错位与溢出的核心代码 */
  display: flex !important;
  flex-direction: row !important;
  align-items: center !important;
  justify-content: center !important;
  padding: 0 !important;
  margin: 0 !important;
  line-height: normal !important; /* 清除默认高行高 */
}

/* 消除微信 button 自带的边框伪元素 */
.play-all-btn::after {
  border: none;
}

.play-all-btn .icon {
  margin-right: 12rpx;
  font-size: 34rpx;
  display: flex;
  align-items: center;
}

.skeleton-list {
  padding: 0 24rpx;
  width: 100%;
}

.skeleton-card {
  position: relative;
  height: 150rpx;
  margin-bottom: 24rpx;
  padding: 32rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #fff;
  overflow: hidden;
}

.skeleton-line {
  height: 28rpx;
  border-radius: 8rpx;
  background: #e8e8e8;
  margin-bottom: 28rpx;
  position: relative;
  overflow: hidden;
}

.skeleton-line::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent, #fff, transparent);
  animation: skeleton-loading 1.5s infinite;
}

.skeleton-en {
  width: 85%;
}

.skeleton-zh {
  width: 60%;
  margin-bottom: 0;
}

@keyframes skeleton-loading {
  from { transform: translateX(-100%); }
  to { transform: translateX(100%); }
}

