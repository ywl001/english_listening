<view class="page">

  <!-- 可拖动添加按钮 -->
  <movable-area class="movable-area">
    <movable-view class="fab-add" direction="all" out-of-bounds="false" x="{{fabX}}" y="{{fabY}}" bindtap="onAddSentence">
      <van-icon name="plus" color="#fff" size="28" />
    </movable-view>
  </movable-area>

  <!-- 搜索区（固定顶部）：输入框内右侧图标切换模式（过滤=本地过滤 / 搜索=云端搜句加入本书，仅引用书可切） -->
  <view class="search-row">
    <view class="search-input-wrap">
      <input
        class="search-input"
        value="{{keyword}}"
        placeholder="{{searchMode === 'filter' ? '过滤列表中的句子' : '搜索英文 / 中文句子加入本书'}}"
        placeholder-class="input-placeholder"
        confirm-type="search"
        bindinput="onSearchInput"
        bindfocus="onInputFocus"
        bindconfirm="onConfirmInput"
      />
      <view wx:if="{{keyword}}" class="clear-btn" catchtap="onClearKeyword">
        <van-icon name="clear" size="16px" color="#CBD5E0" />
      </view>
      <view class="mode-icon {{bookKind === 'ref' ? 'switchable' : 'disabled'}}" catchtap="onToggleSearchMode">
        <van-icon name="{{searchMode === 'filter' ? 'filter-o' : 'search'}}" size="16px" color="{{searchMode === 'filter' ? '#718096' : '#2f80ed'}}" />
      </view>
    </view>
  </view>

  <!-- 搜索结果浮层：覆盖句子列表（hidden 隐藏不销毁，重展开复用上次结果，关键词未变不重搜） -->
  <view class="search-overlay" hidden="{{!(searchMode === 'search' && showResults)}}">
    <scroll-view scroll-y class="overlay-scroll">
      <sentence-search id="searchPanel" inline keyword="{{keyword}}" book-id="{{bookId}}" book-name="{{bookName}}" bind:close="onSearchClose" />
    </scroll-view>
  </view>

  <!-- 句子列表（浮层展开时被覆盖） -->
  <view wx:if="{{displayList.length > 0}}" class="list">

    <view wx:for="{{displayList}}" wx:key="_id" class="swipe-item">
      <van-swipe-cell right-width="{{canDelete ? 70 : 0}}" disabled="{{!canDelete}}">
        <view class="sentence-card" bindtap="playSingleAudio" data-index="{{index}}">
          <view class="card-main">
            <text class="sentence-en">{{item.en || item.english}}</text>
            <text class="sentence-zh">{{item.zh || item.chinese}}</text>
          </view>
          <text class="index-badge">{{index + 1}}</text>
        </view>

        <view slot="right" wx:if="{{canDelete}}" class="delete-button" catchtap="onDelete" data-data="{{item}}">
          <van-icon name="delete-o" size="22" color="#fff" />
          <text>删除</text>
        </view>
      </van-swipe-cell>
    </view>

  </view>
  <!-- 空状态 -->
  <van-empty wx:else image="search" description="暂无相关句子" />

  <!-- 底部播放按钮 -->
  <view wx:if="{{sentenceList.length > 0}}" class="bottom-bar">
    <van-button block round type="warning" icon="audio" bind:click="togglePlayAll">
      全部播放收藏
    </van-button>
  </view>

  <!-- 删除确认弹窗 -->
  <van-dialog use-slot title="{{bookKind === 'ref' ? '取消收藏' : '删除句子'}}" show="{{showDeleteDialog}}" show-cancel-button bind:confirm="confirmDelete" bind:cancel="cancelDelete" bind:close="cancelDelete">
    <view class="dialog-content">
      {{deleteDialogText}}
    </view>
  </van-dialog>

  <van-popup closeable show="{{showGenerator}}" custom-style="height: 95%;" position="bottom" round bind:close="closeGenerator">
    <sentence-generator book-id="{{bookId}}" bind:saved="onSentenceSaved" bind:close="closeGenerator" />
  </van-popup>

</view>