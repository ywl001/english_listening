<view class="page">

  <!-- 可拖动添加按钮 -->
  <movable-area class="movable-area">
    <movable-view class="fab-add" direction="all" out-of-bounds="false" x="{{fabX}}" y="{{fabY}}" bindtap="onAddSentence">
      <van-icon name="plus" color="#fff" size="28" />
    </movable-view>
  </movable-area>

  <!-- 搜索 -->
  <van-search value="{{keyword}}" placeholder="搜索收藏的句子" shape="round" bind:change="onSearchInput" />

  <!-- 句子列表 -->
  <view wx:if="{{displayList.length > 0}}" class="list">

    <view wx:for="{{displayList}}" wx:key="_id" class="swipe-item">
      <van-swipe-cell right-width="{{80}}">
        <van-cell custom-style="background: #e8f3ff;" title="{{index + 1}}. {{item.en || item.english}}" label="{{item.zh || item.chinese}}" border="{{false}}" is-link="{{false}}" bind:click="playSingleAudio" data-index="{{index}}" />

        <view slot="right" class="delete-button" catchtap="onDelete" data-id="{{item._id}}">
          <van-icon name="delete-o" size="22" color="#fff" />
          <text>删除</text>
        </view>
      </van-swipe-cell>
    </view>

  </view>
  <!-- 空状态 -->
  <van-empty wx:else image="search" description="暂无相关句子" />

  <!-- 底部播放按钮 -->
  <view wx:if="{{sentenceList.length > 0}}" class="bottom-bar">
    <van-button block round type="warning" icon="audio" bind:click="togglePlayAll">
      全部播放收藏
    </van-button>
  </view>

  <!-- 删除确认弹窗 -->
  <van-dialog use-slot title="取消收藏" show="{{showDeleteDialog}}" show-cancel-button bind:confirm="confirmDelete" bind:cancel="cancelDelete" bind:close="cancelDelete">
    <view class="dialog-content">
      确定要取消收藏该句子吗？
    </view>
  </van-dialog>

  <van-popup closeable show="{{showGenerator}}" custom-style="height: 95%;" position="bottom" round bind:close="closeGenerator">
    <sentence-generator book-id="{{bookId}}" bind:saved="onSentenceSaved" />
  </van-popup>

</view>