<view class="container">

  <!-- 1. 全屏拖拽区域 (Pointer-events 穿透，不挡住页面点击) -->
  <movable-area class="movable-area">
    <movable-view class="fab-add" direction="all" out-of-bounds="false" x="{{fabX}}" y="{{fabY}}" bindtap="onAddSentence">
      <text class="fab-icon">+</text>
    </movable-view>
  </movable-area>

  <!-- 搜索框 -->
  <view class="search-bar">
    <input class="search-input" placeholder="搜索收藏的句子" bindinput="onSearchInput" value="{{keyword}}" confirm-type="search" />
  </view>

  <!-- 列表 -->
  <view class="list-wrapper">
    <block wx:if="{{displayList.length > 0}}">
      <view wx:for="{{displayList}}" wx:key="_id" class="card-item-wrapper">
        <!-- Vant 滑动单元格组件 -->
        <van-swipe-cell right-width="{{ 80 }}">
          <!-- 主体卡片内容 -->
          <view class="sentence-card {{currentIndex === index && isPlayingAll ? 'playing-card' : ''}}" bindtap="playSingleAudio" data-index="{{index}}">
            <view class="card-left">
              <view class="en-text">
                <text class="index-num">{{index + 1}}. </text>{{item.en || item.english}}
              </view>
              <view class="zh-text">{{item.zh || item.chinese}}</view>
            </view>
          </view>

          <!-- 右侧滑动出来的删除按钮 -->
          <view slot="right" class="van-swipe-cell__right" catchtap="onDelete" data-id="{{item._id}}">
            删除
          </view>
        </van-swipe-cell>
      </view>

      <view class="loading-status"></view>
    </block>

    <view wx:else class="empty-box">
      <text>暂无相关句子</text>
    </view>
  </view>

  <!-- 底部播放按钮 -->
  <view class="bottom-floating-bar" wx:if="{{sentenceList.length > 0}}">
    <button class="play-all-btn" bindtap="togglePlayAll">
      <text class="icon">🎧</text>
      <text>{{isPlayingAll ? '暂停播放' : '全部播放收藏 (' + sentenceList.length + ')'}}</text>
    </button>
  </view>
</view>