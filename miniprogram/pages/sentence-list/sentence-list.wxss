.page {
  min-height: 100vh;
  padding-bottom: 140rpx;
  box-sizing: border-box;
  background: #f7f8fa;
}

.list {
  margin-top: 16rpx;
}

.delete-button {
  width: 160rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: #ee0a24;
  color: #fff;
  font-size: 26rpx;
}

.bottom-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 100;
}

.movable-area {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
  z-index: 101;
}

.fab-add {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #2f80ed;
  box-shadow: 0 8rpx 24rpx rgba(47, 128, 237, .4);
  pointer-events: auto;
}

.dialog-content {
  padding: 32rpx;
  text-align: center;
  font-size: 28rpx;
  color: #333;
}

