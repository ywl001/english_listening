page {
  background-color: #F7FAFC;
  min-height: 100vh;
}

.page {
  min-height: 100vh;
  padding-top: 108rpx; /* 避让固定顶部的搜索区 */
  padding-bottom: 140rpx;
  box-sizing: border-box;
  background: #F7FAFC;
}

/* 搜索区：固定顶部，不随列表滚动 */
.search-row {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 30;
  padding: 12rpx 24rpx;
  background: #F7FAFC;
  box-sizing: border-box;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #fff;
  border-radius: 36rpx;
  padding: 0 16rpx 0 24rpx;
  height: 72rpx;
  box-shadow: 0 2rpx 10rpx rgba(160, 174, 192, .12);
}

.search-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #2D3748;
  height: 72rpx;
}

.input-placeholder {
  color: #A0AEC0;
  font-size: 26rpx;
}

.clear-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 8rpx;
}

/* 模式切换图标：嵌在输入框内右侧 */
.mode-icon {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #F1F5F9;
}

.mode-icon.switchable:active {
  background: #EDF4FF;
}

.mode-icon.disabled {
  opacity: .35;
}

/* 搜索结果浮层：覆盖句子列表与底部"全部播放"按钮，加入后收起 */
.search-overlay {
  position: fixed;
  top: 96rpx;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 120; /* 高于底部播放按钮（z-index: 100） */
  background: #F7FAFC;
}

.overlay-scroll {
  height: 100%;
  padding: 0 30rpx;
  box-sizing: border-box;
}

.list {
  padding: 0 30rpx;
  margin-top: 16rpx;
}

.swipe-item {
  margin-bottom: 24rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

/* 句子卡片（参考 article-list 卡片风格） */
.sentence-card {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(160, 174, 192, .12);
}

.sentence-card:active {
  background-color: #F7FAFC;
}

.card-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.sentence-en {
  font-size: 30rpx;
  font-weight: bold;
  color: #2D3748;
  line-height: 1.4;
}

.sentence-zh {
  font-size: 26rpx;
  color: #718096;
  line-height: 1.5;
  margin-top: 10rpx;
}

.index-badge {
  flex-shrink: 0;
  min-width: 44rpx;
  height: 44rpx;
  margin-left: 16rpx;
  padding: 0 8rpx;
  border-radius: 22rpx;
  background-color: #EDF2F7;
  color: #718096;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.delete-button {
  width: 140rpx;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  background: #ee0a24;
  color: #fff;
  font-size: 24rpx;
  border-radius: 20rpx;
}

.bottom-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 100;
}

.movable-area {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
  z-index: 1;
}

.fab-add {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #2f80ed;
  box-shadow: 0 8rpx 24rpx rgba(47, 128, 237, .4);
  pointer-events: auto;
}

.dialog-content {
  padding: 32rpx;
  text-align: center;
  font-size: 28rpx;
  color: #333;
}

