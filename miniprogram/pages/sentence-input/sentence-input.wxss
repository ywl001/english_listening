page {
  background: #F5F6FA;
}

.page {
  padding: 32rpx;
  box-sizing: border-box;
  min-height: 100vh;
  position: relative;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 24rpx rgba(31, 34, 51, 0.04);
}

.label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #1F2233;
  margin-bottom: 16rpx;
}

.textarea {
  width: 100%;
  height: 140rpx;
  background: #F7F8FC;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 30rpx;
  color: #1F2233;
  line-height: 1.6;
  box-sizing: border-box;
}

.lang-hint {
  display: block;
  font-size: 22rpx;
  color: #6C5CE7;
  margin-top: 12rpx;
}

/* 结果卡片 */
.result-card {
  margin-top: 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(31, 34, 51, 0.04);
}

.text-group {
  margin-bottom: 28rpx;
}

.text-group:last-child {
  margin-bottom: 0;
}

.group-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.group-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #6C5CE7;
  background: #F0EDFF;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

/* 原生播放按钮 */
.play-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: #F7F8FC;
  padding: 6rpx 18rpx;
  border-radius: 30rpx;
  border: 1rpx solid #E5E7EB;
}

.play-btn:active {
  opacity: 0.7;
}

.play-icon {
  font-size: 22rpx;
}

.play-text {
  font-size: 22rpx;
  color: #4B5563;
  font-weight: 500;
}

/* 结果文字样式 */
.result-text {
  display: block;
  font-size: 32rpx;
  color: #1F2233;
  line-height: 1.6;
  word-break: break-all;
}

.en-text {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

.error-text {
  display: block;
  font-size: 26rpx;
  color: #EF4444;
}

/* 底部固定按钮栏 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-shadow: 0 -4rpx 24rpx rgba(31, 34, 51, 0.06);
  box-sizing: border-box;
  z-index: 99;
}

.bottom-bar button {
  flex: 1;
  margin: 0;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-primary {
  background: #6C5CE7;
  color: #FFFFFF;
}

.btn-primary::after {
  border: none;
}

.btn-primary.disabled {
  opacity: 0.6;
}

.bottom-bar-placeholder {
  height: calc(96rpx + 40rpx + constant(safe-area-inset-bottom));
  height: calc(96rpx + 40rpx + env(safe-area-inset-bottom));
}

.btn-save {
  background: #10B981;
  color: #FFFFFF;
}

.btn-save::after {
  border: none;
}

.btn-outline {
  background: #FFFFFF;
  color: #6C5CE7;
  border: 2rpx solid #6C5CE7;
}

.btn-outline::after {
  border: none;
}