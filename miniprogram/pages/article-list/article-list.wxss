page {
  background-color: #F7FAFC;
  min-height: 100vh;
}

/* 不用 .container 类名：app.wxss 模板遗留的 .container 有 padding: 200rpx 0 和居中规则 */
.page-root {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.article-list {
  flex: 1;
  height: 100%;
  padding: 24rpx 30rpx;
  box-sizing: border-box;
}

.article-card {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(160, 174, 192, .12);
}

.article-card:active {
  background-color: #F7FAFC;
}

.card-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.article-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2D3748;
  line-height: 1.4;
}

.article-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 14rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #718096;
}

.meta-order {
  font-size: 24rpx;
  color: #A0AEC0;
}

.arrow {
  flex-shrink: 0;
  font-size: 44rpx;
  color: #CBD5E0;
  margin-left: 16rpx;
}

.empty-tip {
  text-align: center;
  color: #A0AEC0;
  font-size: 28rpx;
  padding: 120rpx 0;
}

/* 滑动删除按钮（与 sentence-book-card 同款） */
.delete-btn {
  width: 70px;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ee0a24;
  color: #fff;
  border-radius: 20rpx;
}
